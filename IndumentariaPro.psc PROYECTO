// EmitirFactura: Formatea e imprime en pantalla el comprobante de venta fiscal (Factura A, B o C).
SubProceso EmitirFactura(tipoFactura, clienteNombre, producto, talle, cant, montoTotal, medioPago)
	Limpiar Pantalla
	Escribir "========================================="
	Escribir "             FACTURA TIPO ", tipoFactura
	Escribir "========================================="
	Escribir "Cliente: ", clienteNombre
	Escribir "Detalle: ", cant, " x ", producto, " (Talle ", talle, ")"
	Escribir "Medio de Pago: ", medioPago
	Escribir "-----------------------------------------"
	Escribir "TOTAL FINAL A PAGAR: $", montoTotal
	Escribir "========================================="
FinSubProceso

// RealizarVenta: Procesa la compra de un cliente, aplica descuentos, actualiza stock y suma a la caja diaria.
SubProceso RealizarVenta(MatrizPrendas Por Referencia, MatrizStock Por Referencia, cantPrendas, cajaTotal Por Referencia, cajaEfectivo Por Referencia, cajaTarjeta Por Referencia, totalFacturas Por Referencia)
	Definir codBuscado, talleBuscado, clienteNombre, tipoFac, medioPagoStr Como Cadena
	Definir i, pos, cantComprar, medioPago, talleCol Como Entero
	Definir subtotal, totalFinal Como Real
	Definir encontrado Como Logico
	
	Limpiar Pantalla
	Escribir "=== MÓDULO DE ATENCIÓN Y VENTAS ==="
	Escribir "Ingrese el Código del Producto a vender (ej: RE01): "; Leer codBuscado
	
	// Buscamos si el código existe en la matriz
	encontrado <- Falso
	Para i <- 1 Hasta cantPrendas Hacer
		Si MatrizPrendas[i,1] == codBuscado Entonces
			encontrado <- Verdadero
			pos <- i // Guardamos la fila donde se encontró
		FinSi
	FinPara
	
	Si encontrado Entonces
		Escribir "Producto seleccionado: ", MatrizPrendas[pos,2]
		Escribir "Ingrese Talle deseado (S, M, L): "; Leer talleBuscado
		talleBuscado <- Mayusculas(talleBuscado) // Pasamos a mayúscula para evitar errores
		
		// Mapeamos el texto del talle a la columna de la MatrizStock
		Segun talleBuscado Hacer
			"S": talleCol <- 2
			"M": talleCol <- 3
			"L": talleCol <- 4
			De Otro Modo: talleCol <- 0
		FinSegun
		
		Si talleCol > 0 Entonces
			Escribir "Unidades disponibles en talle ", talleBuscado, ": ", MatrizStock[pos, talleCol]
			Escribir "Ingrese Cantidad a comprar: "; Leer cantComprar
			
			// Validamos que haya stock suficiente para efectuar la venta
			Si cantComprar <= MatrizStock[pos, talleCol] Y cantComprar > 0 Entonces
				subtotal <- MatrizStock[pos, 1] * cantComprar
				
				Escribir "Ingrese Nombre del Cliente: "; Leer clienteNombre
				Escribir "Seleccione Tipo de Factura (A, B, C): "; Leer tipoFac
				Escribir "Forma de Pago (1: Efectivo -10% Descuento, 2: Tarjeta / Transferencia): "
				Leer medioPago
				
				// Aplicación de regla de negocio: 10% de descuento en efectivo
				Si medioPago == 1 Entonces
					totalFinal <- subtotal * 0.90
					medioPagoStr <- "Efectivo (10% Descuento Aplicado)"
					cajaEfectivo <- cajaEfectivo + totalFinal
				Sino
					totalFinal <- subtotal
					medioPagoStr <- "Tarjeta / Transferencia Bancaria"
					cajaTarjeta <- cajaTarjeta + totalFinal
				FinSi
				
				// Actualización de variables de estado
				MatrizStock[pos, talleCol] <- MatrizStock[pos, talleCol] - cantComprar // Restamos stock
				cajaTotal <- cajaTotal + totalFinal                                     // Sumamos al total diario
				totalFacturas <- totalFacturas + 1                                       // Incrementamos contador de comprobantes
				
				// Emitimos el comprobante por pantalla
				EmitirFactura(Mayusculas(tipoFac), clienteNombre, MatrizPrendas[pos,2], talleBuscado, cantComprar, totalFinal, medioPagoStr)
			Sino
				Escribir "Error: Stock insuficiente en ese talle o cantidad ingresada no válida."
			FinSi
		Sino
			Escribir "Error: Talle ingresado incorrecto."
		FinSi
	Sino
		Escribir "Error: El código de producto ingresado no existe."
	FinSi
	Esperar Tecla
FinSubProceso

// CierreCajaZ: Requisito pedido por el profesor. Muestra el resumen del día y resetea las métricas a cero.
SubProceso CierreCajaZ(cajaTotal Por Referencia, cajaEfectivo Por Referencia, cajaTarjeta Por Referencia, totalFacturas Por Referencia)
	Limpiar Pantalla
	Escribir "========================================="
	Escribir "       INFORME DE CIERRE DE CAJA Z       "
	Escribir "========================================="
	Escribir "Cantidad de Facturas Emitidas: ", totalFacturas
	Escribir "Total Recaudado en Efectivo: $", cajaEfectivo
	Escribir "Total Recaudado en Tarjeta/Transf: $", cajaTarjeta
	Escribir "-----------------------------------------"
	Escribir "RECAUDACIÓN TOTAL DEL DÍA: $", cajaTotal
	Escribir "========================================="
	Escribir "Informe generado. La caja diaria ha sido reiniciada a $0."
	
	// Puesta a cero de la caja para la siguiente jornada
	cajaTotal <- 0;
	cajaEfectivo <- 0;
	cajaTarjeta <- 0;
	totalFacturas <- 0;
	Esperar Tecla
FinSubProceso


