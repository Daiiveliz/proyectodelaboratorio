// MenuAdmin: Opciones exclusivas para el Administrador
SubProceso MenuAdmin(MatrizUsuarios Por Referencia, VectorRol Por Referencia, cantUsuarios Por Referencia, MatrizProveedores Por Referencia, cantProv Por Referencia, MatrizPrendas Por Referencia, MatrizStock Por Referencia, VectorProvPrenda Por Referencia, cantPrendas Por Referencia, cajaTotal Por Referencia, cajaEfectivo Por Referencia, cajaTarjeta Por Referencia, totalFacturas Por Referencia)
	Definir opc Como Entero
	opc <- 0
	Mientras opc <> 6 Hacer
		Limpiar Pantalla
		Escribir "=== PANEL ADMINISTRATIVO ==="
		Escribir "1. Registrar Nuevo Usuario (Admin, Repositor, Proveedor, Cliente)"
		Escribir "2. Listar Todos los Usuarios"
		Escribir "3. Registrar Nuevo Proveedor"
		Escribir "4. Cargar Nueva Prenda al Inventario"
		Escribir "5. Realizar Cierre de Caja Z"
		Escribir "6. Volver al Menú Principal"
		Escribir "Seleccione una opción: "
		Leer opc
		
		Segun opc Hacer
			1: RegistrarUsuario(MatrizUsuarios, VectorRol, cantUsuarios)
			2: ListarUsuarios(MatrizUsuarios, VectorRol, cantUsuarios)
			3: RegistrarProveedor(MatrizProveedores, cantProv)
			4: RegistrarPrenda(MatrizPrendas, MatrizStock, VectorProvPrenda, cantPrendas)
			5: CierreCajaZ(cajaTotal, cajaEfectivo, cajaTarjeta, totalFacturas)
			6: Escribir "Regresando al menú principal..."
		FinSegun
	FinMientras
FinSubProceso

// MenuRepositor: Opciones exclusivas para el Repositor de mercadería
SubProceso MenuRepositor(MatrizPrendas Por Referencia, MatrizStock Por Referencia, cantPrendas)
	Definir opc Como Entero
	opc <- 0
	Mientras opc <> 3 Hacer
		Limpiar Pantalla
		Escribir "=== PANEL DE REPOSITOR ==="
		Escribir "1. Ver Stock General por Talle"
		Escribir "2. Ver Alertas de Stock Crítico (< 3 unidades)"
		Escribir "3. Volver al Menú Principal"
		Escribir "Seleccione una opción: "; Leer opc
		
		Segun opc Hacer
			1: MostrarStock(MatrizPrendas, MatrizStock, cantPrendas)
			2: AlertaStockCritico(MatrizPrendas, MatrizStock, cantPrendas)
			3: Escribir "Regresando al menú principal..."
		FinSegun
	FinMientras
FinSubProceso

// MenuProveedor: Opciones para que el Proveedor controle sus productos en nuestro local
SubProceso MenuProveedor(MatrizPrendas Por Referencia, MatrizStock Por Referencia, VectorProvPrenda Por Referencia, cantPrendas)
	Definir idProvBuscado, i Como Entero
	Definir encontrado Como Logico
	encontrado <- Falso
	
	Limpiar Pantalla
	Escribir "=== PANEL DE ACCESO A PROVEEDORES ==="
	Escribir "Ingrese su ID de Proveedor para consultar su mercadería (ej: 101): "; Leer idProvBuscado
	
	Escribir "---------------------------------------------------------"
	Escribir "MERCADERÍA SUMINISTRADA EN NUESTRO LOCAL:"
	
	// Filtra e imprime únicamente los productos que pertenezcan a ese ID de proveedor
	Para i <- 1 Hasta cantPrendas Hacer
		Si VectorProvPrenda[i] == idProvBuscado Entonces
			encontrado <- Verdadero
			Escribir "Producto: ", MatrizPrendas[i,2], " | Stock -> S: ", MatrizStock[i,2], " u. | M: ", MatrizStock[i,3], " u. | L: ", MatrizStock[i,4], " u."
		FinSi
	FinPara
	
	Si No encontrado Entonces
		Escribir "No existen prendas registradas en el sistema vinculadas a su ID de Proveedor."
	FinSi
	Escribir "---------------------------------------------------------"
	Esperar Tecla
FinSubProceso

// MenuCliente: Módulo de ventas y consulta de catálogo
SubProceso MenuCliente(MatrizPrendas Por Referencia, MatrizStock Por Referencia, cantPrendas, cajaTotal Por Referencia, cajaEfectivo Por Referencia, cajaTarjeta Por Referencia, totalFacturas Por Referencia)
	Definir opc Como Entero
	opc <- 0
	Mientras opc <> 3 Hacer
		Limpiar Pantalla
		Escribir "=== PANEL DE CLIENTE / ATENCIÓN PÚBLICA ==="
		Escribir "1. Ver Catálogo de Productos y Precios"
		Escribir "2. Comprar Producto (Atención al Cliente)"
		Escribir "3. Volver al Menú Principal"
		Escribir "Seleccione una opción: "; Leer opc
		
		Segun opc Hacer
			1: MostrarStock(MatrizPrendas; MatrizStock;cantPrendas)
			2: RealizarVenta(MatrizPrendas, MatrizStock, cantPrendas, cajaTotal, cajaEfectivo,:cajaTarjeta; totalFacturas)
			3: Escribir "Regresando al menú principal..."
		FinSegun
	FinMientras
