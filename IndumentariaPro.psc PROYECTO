Algoritmo IndumentariaPro
	
	// 1. Declaración e Inicialización de Arreglos y Matrices Multidimensionales
	Dimension MatrizUsuarios[100, 6]      // Guarda [ID, DNI, Nombre, Apellido, Teléfono, Dirección]
	Dimension VectorRol[100]              // Guarda el rol (1:Admin, 2:Repositor, 3:Proveedor, 4:Cliente)
	Dimension MatrizProveedores[50, 4]    // Guarda [ID_Prov, Razón Social, Origen, Especialidad]
	Dimension MatrizPrendas[100, 3]       // Guarda [Código, Nombre, Categoría]
	Dimension MatrizStock[100, 4]         // Guarda [Precio, Stock S, Stock M, Stock L]
	Dimension VectorProvPrenda[100]       // Relación: Guarda el ID de proveedor por cada producto
	
	// 2. Definición de Variables Contador de Registros
	Definir cantUsuarios, cantProv, cantPrendas Como Entero
	cantUsuarios <- 0
	cantProv <- 0
	cantPrendas <- 0
	
	// 3. Definición de Variables de Control Financiero y Caja Z
	Definir cajaTotal, cajaEfectivo, cajaTarjeta Como Real
	Definir totalFacturas Como Entero
	cajaTotal <- 0
	cajaEfectivo <- 0
	cajaTarjeta <- 0
	totalFacturas <- 0
	
	// 4. Ejecución de Carga de Datos Iniciales para Testeo
	CargarDatosIniciales(MatrizUsuarios, VectorRol, cantUsuarios, MatrizProveedores, cantProv, MatrizPrendas, MatrizStock, VectorProvPrenda, cantPrendas)
	
	// 5. Bucle Interactivo del Menú Principal
	Definir opciones Como Entero
	opciones <- 0
	
	Mientras opciones <> 5 Hacer
		Limpiar Pantalla
		Escribir "========================================="
		Escribir "    SISTEMA INDUMENTARIA PRO - PSEINT    "
