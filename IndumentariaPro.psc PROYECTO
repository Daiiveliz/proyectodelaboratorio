		Escribir "Seleccione una opción: "
		Leer opciones
		
		// Derivación a cada subproceso según el menú seleccionado
		Segun opciones Hacer
			1: MenuAdmin(MatrizUsuarios, VectorRol, cantUsuarios, MatrizProveedores, cantProv, MatrizPrendas, MatrizStock, VectorProvPrenda, cantPrendas, cajaTotal, cajaEfectivo, cajaTarjeta, totalFacturas)
			2: MenuRepositor(MatrizPrendas, MatrizStock, cantPrendas)
			3: MenuProveedor(MatrizPrendas, MatrizStock, VectorProvPrenda, cantPrendas)
			4: MenuCliente(MatrizPrendas, MatrizStock, cantPrendas, cajaTotal, cajaEfectivo, cajaTarjeta, totalFacturas)
			5: Escribir "Gracias por utilizar Indumentaria Pro. ¡Hasta luego!"
