// RegistrarPrenda: Da de alta un nuevo producto ingresando sus cantidades iniciales por talle.
SubProceso RegistrarPrenda(MatrizPrendas Por Referencia, MatrizStock Por Referencia, VectorProvPrenda Por Referencia, cantPrendas Por Referencia)
	Si cantPrendas < 100 Entonces
		cantPrendas <- cantPrendas + 1
		Limpiar Pantalla
		Escribir "=== CARGA DE NUEVA PRENDA ==="
		Escribir "Código de Prenda (ej: RE02): "; Leer MatrizPrendas[cantPrendas, 1]
		Escribir "Nombre / Descripción: "; Leer MatrizPrendas[cantPrendas, 2]
		Escribir "Categoría: "; Leer MatrizPrendas[cantPrendas, 3]
		
		// Validación: El precio no puede ser negativo ni cero
		Escribir "Precio de Venta ($): "; Leer MatrizStock[cantPrendas, 1]
		Mientras MatrizStock[cantPrendas, 1] <= 0 Hacer
			Escribir "El precio debe ser un monto positivo. Reingrese: "
			Leer MatrizStock[cantPrendas, 1]
		FinMientras
		
		// Carga de inventario distribuido por talle
		Escribir "Cantidad Inicial Talle S: "; Leer MatrizStock[cantPrendas, 2]
		Escribir "Cantidad Inicial Talle M: "; Leer MatrizStock[cantPrendas, 3]
		Escribir "Cantidad Inicial Talle L: "; Leer MatrizStock[cantPrendas, 4]
		
		// Asignación con el proveedor
		Escribir "ID del Proveedor asignado a este producto: "; Leer VectorProvPrenda[cantPrendas]
		
		Escribir "-----------------------------------------"
		Escribir "¡Prenda registrada en el catálogo!"
	Sino
		Escribir "Error: Capacidad máxima de productos alcanzada."
	FinSi
	Esperar Tecla
FinSubProceso

// MostrarStock: Imprime la lista completa de productos disponibles y el stock por talle.
SubProceso MostrarStock(MatrizPrendas Por Referencia, MatrizStock Por Referencia, cantPrendas)
	Definir i Como Entero
	Limpiar Pantalla
	Escribir "========================================================="
	Escribir "                 CATÁLOGO Y STOCK ACTUAL                 "
	Escribir "========================================================="
	Escribir "COD   | NOMBRE            | PRECIO  | TALLE S | TALLE M | TALLE L"
	Escribir "---------------------------------------------------------"
	
	Para i <- 1 Hasta cantPrendas Hacer
		Escribir MatrizPrendas[i,1], " | ", MatrizPrendas[i,2], " | $", MatrizStock[i,1], " | ", MatrizStock[i,2], " u.    | ", MatrizStock[i,3], " u.    | ", MatrizStock[i,4], " u."
			Escribir "---------------------------------------------------------"
			Esperar Tecla
		FinPara
		
FinSubProceso

// AlertaStockCritico: Requisito especial. Filtra y muestra solo los productos con menos de 3 unidades en algún talle.
SubProceso AlertaStockCritico(MatrizPrendas Por Referencia, MatrizStock Por Referencia, cantPrendas)
	Definir i Como Entero
	Definir hayAlerta Como Logico
	hayAlerta <- Falso
	
	Limpiar Pantalla
	Escribir "========================================================="
	Escribir "        ALERTAS DE REPOSICIÓN (MENOS DE 3 UNIDADES)      "
	Escribir "========================================================="
	
	Para i <- 1 Hasta cantPrendas Hacer
		// Si en el talle S, M o L quedan menos de 3 unidades, se activa la alerta
		Si MatrizStock[i,2] < 3 O MatrizStock[i,3] < 3 O MatrizStock[i,4] < 3 Entonces
			Escribir "¡ALERTA! Prenda: ", MatrizPrendas[i,2], " (Cod: ", MatrizPrendas[i,1], ")"
			Escribir "-> Quedan -> Talle S: ", MatrizStock[i,2], " | Talle M: ", MatrizStock[i,3], " | Talle L: ", MatrizStock[i,4]
			Escribir "---------------------------------------------------------"
			hayAlerta <- Verdadero
		FinSi
	FinPara
	
	Si No hayAlerta Entonces
		Escribir "Excelente: Todo el stock supera las 3 unidades de reposición."
	FinSi
	Esperar Tecla
FinSubProceso


