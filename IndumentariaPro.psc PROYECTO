// ============================================================================
// SUBPROCESOS DE GESTIÓN DE USUARIOS Y PROVEEDORES
// ============================================================================

// RegistrarUsuario: Permite al Administrador dar de alta una nueva persona en el sistema.
SubProceso RegistrarUsuario(MatrizUsuarios Por Referencia, VectorRol Por Referencia, cantUsuarios Por Referencia)
	Definir rolElegido Como Entero
	
	// Controlamos no superar la capacidad máxima de la matriz (100 filas)
	Si cantUsuarios < 100 Entonces
		cantUsuarios <- cantUsuarios + 1 // Incrementamos el contador
		Limpiar Pantalla
		Escribir "=== ALTA DE NUEVO USUARIO ==="
		
		// Asignamos el ID de forma automática convirtiendo el contador a texto
		MatrizUsuarios[cantUsuarios, 1] <- ConvertirATexto(cantUsuarios)
		Escribir "ID Asignado por el sistema: ", MatrizUsuarios[cantUsuarios, 1]
		
		// Lectura de datos personales
		Escribir "Ingrese DNI: "; Leer MatrizUsuarios[cantUsuarios, 2]
		Escribir "Ingrese Nombre: "; Leer MatrizUsuarios[cantUsuarios, 3]
		Escribir "Ingrese Apellido: "; Leer MatrizUsuarios[cantUsuarios, 4]
		Escribir "Ingrese Teléfono: "; Leer MatrizUsuarios[cantUsuarios, 5]
		Escribir "Ingrese Dirección: "; Leer MatrizUsuarios[cantUsuarios, 6]
		
		// Selección y validación del perfil del usuario
		Escribir "Seleccione el Rol (1: Admin, 2: Repositor, 3: Proveedor, 4: Cliente): "
		Leer rolElegido
		
		// Validamos mediante un bucle Mientras que el rol sea un número del 1 al 4
		Mientras rolElegido < 1 O rolElegido > 4 Hacer
			Escribir "Opción de rol no válida. Ingrese entre 1 y 4: "
			Leer rolElegido
		FinMientras
		
		VectorRol[cantUsuarios] <- rolElegido // Guardamos el rol en el arreglo paralelo
		Escribir "-----------------------------------------"
		Escribir "¡Usuario registrado exitosamente!"
	Sino
		Escribir "Error: Se alcanzó el límite máximo de usuarios (100)."
	FinSi
	Esperar Tecla // Pausa hasta que el usuario presione una tecla
FinSubProceso

// ListarUsuarios: Muestra en pantalla todos los usuarios registrados con su perfil.
SubProceso ListarUsuarios(MatrizUsuarios Por Referencia, VectorRol Por Referencia, cantUsuarios)
	Definir i Como Entero
	Limpiar Pantalla
	Escribir "========================================================="
	Escribir "                   LISTADO DE USUARIOS                   "
	Escribir "========================================================="
	Escribir "ID | DNI      | Nombre y Apellido     | Rol"
	Escribir "---------------------------------------------------------"
	
	// Recorremos la matriz hasta la cantidad actual de usuarios cargados
	Para i <- 1 Hasta cantUsuarios Hacer
		Escribir MatrizUsuarios[i,1], "  | ", MatrizUsuarios[i,2], " | ", MatrizUsuarios[i,3], " ", MatrizUsuarios[i,4], " | " Sin Saltar
		
		// Traducimos el número de rol guardado en VectorRol a su equivalente en texto
		Segun VectorRol[i] Hacer
			1: Escribir "Administrador"
			2: Escribir "Repositor"
			3: Escribir "Proveedor"
			4: Escribir "Cliente"
		FinSegun
	FinPara
	
	Escribir "---------------------------------------------------------"
	Esperar Tecla
FinSubProceso

// RegistrarProveedor: Permite cargar un proveedor indicando si es nacional o extranjero.
SubProceso RegistrarProveedor(MatrizProveedores Por Referencia, cantProv Por Referencia)
	Definir origenOpc Como Entero
	
	Si cantProv < 50 Entonces
		cantProv <- cantProv + 1
		Limpiar Pantalla
		Escribir "=== ALTA DE PROVEEDOR ==="
		Escribir "Ingrese ID del Proveedor (ej: 102): "; Leer MatrizProveedores[cantProv, 1]
		Escribir "Ingrese Nombre / Razón Social: "; Leer MatrizProveedores[cantProv, 2]
		
		// Selección de origen
		Escribir "Origen del Proveedor (1: Nacional, 2: Extranjero): "; Leer origenOpc
		Si origenOpc == 1 Entonces
			MatrizProveedores[cantProv, 3] <- "Nacional"
		Sino
			MatrizProveedores[cantProv, 3] <- "Extranjero"
		FinSi
		
		Escribir "Especialidad (1 o 2 tipos de prendas, ej: Camperas/Pantalones): "
		Leer MatrizProveedores[cantProv, 4]
		
		Escribir "-----------------------------------------"
		Escribir "¡Proveedor registrado con éxito!"
	Sino
		Escribir "Error: Base de datos de proveedores llena."
	FinSi
	Esperar Tecla
FinSubProceso


// ============================================================================
// SUBPROCESOS DE INVENTARIO Y CONTROL DE STOCK
